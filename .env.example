# Copy to .env. The agent reads these; nothing here is secret except the token.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
E2E_AGENT_REPO=agent-substrate/substrate
E2E_AGENT_MODEL=gemini-3.7-flash
# gemini-3.7-flash is served from the global endpoint. This overrides
# GOOGLE_CLOUD_LOCATION for model calls only.
E2E_AGENT_LOCATION=global
E2E_AGENT_MAX_TURNS=3
# GITHUB_TOKEN is required locally - the source has no `gh auth token`
# fallback, because Agent Runtime has neither the gh CLI nor an interactive
# login. `task setup` (via `task local-token`) writes one in here from your gh
# session; .env is gitignored. Deployed, the agent authenticates as a GitHub
# App instead (GITHUB_APP_ID / GITHUB_APP_INSTALLATION_ID /
# GITHUB_APP_PRIVATE_KEY_SECRET). `task deploy` copies them into Agent Runtime.
# GITHUB_TOKEN=...
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_SECRET=e2e-agent-github-app-private-key
# Path to the PEM. deploy/provision.sh uploads it into the secret above.
# GITHUB_APP_PRIVATE_KEY_FILE=
# task deploy reads the App id and installation id from the environment
# and sends them to Agent Runtime. The rest of the runtime env is
# deploy/e2e-agent.env. .env itself is not copied, so GITHUB_TOKEN stays local.
# COMPLETIONS_BUCKET=your-gcp-project-id-e2e-agent-completions
# Optional. Unset, sre-coordinator looks up the Agent Runtime named e2e-agent.
# E2E_AGENT_ENGINE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ENGINE
# Required for the coordinator's history route. No default: the resource name
# is project-specific. deploy/data_agent.sh prints it. Location is us.
# ENV_INTELLIGENCE_AGENT=projects/YOUR_PROJECT/locations/us/dataAgents/environment-intelligence

# Eval warehouse (task bq:*). Dataset lives in GOOGLE_CLOUD_PROJECT.
# BQ_DATASET=ci_agent_eval
# BQ_LOCATION=us-central1
# E2E_AGENT_BQ_WRITE=1
