# Production env for the e2e-agent engine. task deploy passes this file to
# agents-cli deploy --update-env-vars. .env is not copied: a local
# GITHUB_TOKEN must not land in Agent Runtime.
#
# Do not set GOOGLE_CLOUD_PROJECT. Agent Runtime injects it and rejects
# the deploy if it is present.
#
# deploy/deploy.sh appends GITHUB_APP_ID and GITHUB_APP_INSTALLATION_ID
# from the environment. Both are required. It also replaces the upload
# path below.

E2E_AGENT_REPO=agent-substrate/substrate
E2E_AGENT_MODEL=gemini-3.7-flash
E2E_AGENT_LOCATION=global
# Model calls use global. Session region is AGENT_LOCATION, which
# deploy.sh sets from the deploy region (default us-central1).
GOOGLE_CLOUD_LOCATION=global
AGENT_LOCATION=us-central1

GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# deploy/deploy.sh replaces this value with gs://$COMPLETIONS_BUCKET/completions.
# COMPLETIONS_BUCKET defaults to $GOOGLE_CLOUD_PROJECT-e2e-agent-completions.
OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://PROJECT-e2e-agent-completions/completions

# Caps the investigator loop. Compared in the graph.
E2E_AGENT_MAX_TURNS=3
# Caps total Gemini calls across the whole invocation.
ADK_MAX_LLM_CALLS=60
# Client poll deadline and job_timeout_ms for every warehouse MERGE.
E2E_AGENT_BQ_TIMEOUT_S=30
# Backoff retries per Gemini call before the routed quota_exhausted exit.
E2E_AGENT_MODEL_RETRY_ATTEMPTS=6

BQ_DATASET=ci_agent_eval
BQ_LOCATION=us-central1
E2E_AGENT_BQ_WRITE=1
GITHUB_APP_PRIVATE_KEY_SECRET=e2e-agent-github-app-private-key
