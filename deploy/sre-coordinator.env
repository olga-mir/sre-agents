# Production env for the sre-coordinator engine. task deploy passes this
# file to agents-cli. deploy.sh appends ENV_INTELLIGENCE_AGENT (required)
# and E2E_AGENT_ENGINE when that variable is set.
#
# Do not set GOOGLE_CLOUD_PROJECT. Agent Runtime injects it.

SRE_AGENT_MODULE=agents.sre_coordinator.runtime
AGENT_LOCATION=us-central1
E2E_AGENT_MODEL=gemini-3.7-flash
E2E_AGENT_LOCATION=global
GOOGLE_CLOUD_LOCATION=global

# The us data agent has no mTLS DNS name. false selects the plain host
# and asks google-auth for an unbound token.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_USE_MTLS_ENDPOINT=never

GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# SPAN_ONLY puts content on the span. e2e-agent uses the GCS upload hook
# instead; this engine does not.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
